{
  "name": "eagle-to-figjam",
  "version": "0.1.0",
  "private": true,
  "description": "Export selected images from Eagle directly onto the FigJam canvas via a local bridge.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n eagle,figjam -c blue,magenta \"npm:dev -w packages/eagle-plugin\" \"npm:dev -w packages/figjam-plugin\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
